{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracebolt:linux-complete-overview:v1",
  "title": "Tracebolt complete process and mounted-filesystem capture",
  "description": "Held candidate. Cross-field equality, byte lengths, ordering, strict duplicate rejection and status/null consistency are additionally enforced by completeoverview.Validate and DecodeStrict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationId",
    "captureStartedAt",
    "captureFinishedAt",
    "scope",
    "processes",
    "volumes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "tracebolt.linux-complete-overview.v1"
    },
    "generationId": {
      "type": "string",
      "pattern": "^sample_[0-9a-f]{32}$"
    },
    "captureStartedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "captureFinishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "scope": {
      "type": "string",
      "const": "agent-visible-linux-namespaces"
    },
    "processes": {
      "$ref": "#/$defs/ProcessSection"
    },
    "volumes": {
      "$ref": "#/$defs/VolumeSection"
    }
  },
  "$defs": {
    "FieldCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "denied",
        "exited",
        "invalid",
        "unsupported",
        "unavailable",
        "notApplicable"
      ],
      "properties": {
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "denied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "exited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "invalid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      }
    },
    "SectionMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationId",
        "coverage",
        "reason",
        "observedCount",
        "countExact",
        "fieldCoverage"
      ],
      "properties": {
        "generationId": {
          "type": "string",
          "pattern": "^sample_[0-9a-f]{32}$"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "none",
            "source_missing",
            "permission_denied",
            "not_supported",
            "timeout",
            "invalid_source",
            "read_failed",
            "item_limit",
            "byte_limit",
            "collector_busy",
            "not_collected",
            "mount_changed"
          ]
        },
        "observedCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "countExact": {
          "type": "boolean"
        },
        "fieldCoverage": {
          "$ref": "#/$defs/FieldCoverage"
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "denied",
            "exited",
            "invalid",
            "unsupported",
            "unavailable",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "none",
            "source_missing",
            "permission_denied",
            "not_supported",
            "timeout",
            "invalid_source",
            "read_failed",
            "item_limit",
            "byte_limit",
            "collector_busy",
            "not_collected",
            "process_gone",
            "mount_changed",
            "remote_filesystem_skipped",
            "not_applicable"
          ]
        }
      }
    },
    "Process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "parentPid",
        "name",
        "state",
        "rssBytes",
        "cpuTimeSeconds",
        "threads",
        "observation"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "parentPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "running",
                "sleeping",
                "disk_sleep",
                "stopped",
                "tracing_stop",
                "zombie",
                "dead",
                "idle",
                "parked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rssBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cpuTimeSeconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "threads": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        }
      }
    },
    "Volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mountPoint",
        "filesystem",
        "kind",
        "filesystemGroup",
        "capacityScope",
        "totalBytes",
        "availableBytes",
        "usedPercent",
        "measurement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mount_[1-9][0-9]*$"
        },
        "mountPoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "filesystem": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "memory",
            "virtual",
            "remote",
            "unknown"
          ]
        },
        "filesystemGroup": {
          "type": "string",
          "pattern": "^fs_[0-9]+_[0-9]+$"
        },
        "capacityScope": {
          "type": "string",
          "const": "agent-mount-namespace"
        },
        "totalBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "availableBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "usedPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement": {
          "$ref": "#/$defs/Observation"
        }
      }
    },
    "ProcessSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "items"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/SectionMeta"
        },
        "items": {
          "type": "array",
          "maxItems": 32768,
          "items": {
            "$ref": "#/$defs/Process"
          }
        }
      }
    },
    "VolumeSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "items"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/SectionMeta"
        },
        "items": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/Volume"
          }
        }
      }
    }
  }
}
