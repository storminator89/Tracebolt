# Rendered only by the separately approved fixed-path journal setup.
[Unit]
Description=Tracebolt root-owned journal reader socket (candidate)

[Socket]
ListenStream=/run/tracebolt-journal-reader/reader.sock
SocketUser=root
SocketGroup=@AGENT_GID@
SocketMode=0660
DirectoryMode=0755
FileDescriptorName=journal-reader
Service=tracebolt-journal-reader.service
Accept=no
Backlog=2
RemoveOnStop=yes

# SocketGroup is the unchanged agent's EXISTING primary group. Never add the
# agent to systemd-journal/adm/wheel or grant journal ACLs/capabilities.
# Parent directories must be root-owned and not group/other-writable.
[Install]
WantedBy=sockets.target
